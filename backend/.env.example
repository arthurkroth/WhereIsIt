NODE_ENV=<environment>
PORT=<server_port>

# Public URL the frontend is served from, no trailing slash
# (e.g. https://whereisit.ie in production, http://localhost:3000 in dev).
# Used to build links in emails (verification, password reset) and to
# restrict CORS to this origin. Required — the app will not start without it.
APP_BASE_URL=<app_base_url>

DB_HOST=<database_host>
DB_PORT=<database_port>
DB_USER=<database_user>
DB_PASSWORD=<database_password>
DB_NAME=<database_name>

JWT_SECRET=JWTSECRET
JWT_EXPIRES_IN=1h

FIELD_ENC_KEY_BASE64=32byte_key_base64

UPLOAD_DIR=<upload_directory_path>
MAX_FILE_MB=10

# Required — all email (verification, password reset, admin alerts, ticket
# replies, warranty alerts) is sent through Resend. The app will not start
# without these set.
# Get RESEND_API_KEY from https://resend.com/api-keys after verifying your
# sending domain (SPF/DKIM DNS records) in the Resend dashboard.
# EMAIL_FROM_ADDRESS must use an address on that verified domain —
# NOT onboarding@resend.dev, which only delivers to your own Resend account email.
RESEND_API_KEY=<resend_api_key>
EMAIL_FROM_ADDRESS="WhereIsIt? <noreply@ywhereisit.ie>"